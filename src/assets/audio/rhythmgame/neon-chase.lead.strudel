// Neon Chase's lead: the notes the player hits. Sections match neon-chase.strudel.
setcpm(128/4)

const verse = note(`<
  [e5 ~ ~ g5 ~ ~ b4 e5]
  [c5 ~ ~ e5 ~ ~ g5 e5]
  [d5 ~ ~ g5 ~ ~ b4 d5]
  [a4 ~ ~ d5 ~ ~ f#5 d5]>`)
const lift = note(`<
  [a4 c5 e5 a5 e5 c5 a4 c5]
  [g4 c5 e5 g5 e5 c5 g4 c5]
  [b4 e5 g5 e5 b4 e5 g5 e5]
  [a4 d5 f#5 a5 f#5 d5 a4 d5]>`)
const breakdown = note("<[e5 b4] [c5 g5] [d5 b4] [f#5 a4]>")
const lastVerse = note(`<
  [e5 [f#5 g5] ~ g5 ~ [a5 g5] b4 e5]
  [c5 [d5 e5] ~ e5 ~ [a5 g5] g5 e5]
  [d5 [e5 f#5] ~ g5 ~ [a5 g5] b4 d5]
  [a4 [b4 c5] ~ d5 ~ [g5 f#5] f#5 d5]>`)
const ending = note("<e5 ~>")

arrange([4, silence], [8, verse], [8, lift], [4, breakdown], [8, lastVerse], [2, ending]).s("triangle")
