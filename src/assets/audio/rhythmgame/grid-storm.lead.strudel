// Grid Storm's lead: the notes the player hits. Sections match grid-storm.strudel.
setcpm(140/4)

const verse = note(`<
  [d5 ~ f5 d5 ~ a4 ~ d5]
  [d5 ~ f5 d5 ~ bb4 ~ f5]
  [c5 ~ f5 c5 ~ f4 ~ c5]
  [c5 ~ e5 c5 ~ g4 ~ [a4 c5]]>`)
const lift = note(`<
  [g4 bb4 d5 g5 ~ d5 bb4 g4]
  [bb4 d5 f5 d5 ~ f5 d5 bb4]
  [a4 d5 f5 a5 ~ f5 d5 a4]
  [a4 c#5 e5 a5 ~ e5 c#5 a4]>`)
const breakdown = note("<[d5 a4] [f5 d5] [c5 f5] [e5 g4]>")
const lastVerse = note(`<
  [d5 [e5 f5] ~ d5 a5 ~ f5 [e5 d5]]
  [d5 [e5 f5] ~ bb4 d5 ~ f5 [g5 f5]]
  [c5 [d5 c5] ~ a4 f5 ~ c5 [d5 c5]]
  [c5 [d5 e5] ~ g4 e5 ~ g4 [a4 c5]]>`)
const ending = note("<d5 ~>")

arrange([4, silence], [8, verse], [8, lift], [4, breakdown], [8, lastVerse], [2, ending]).s("triangle")
